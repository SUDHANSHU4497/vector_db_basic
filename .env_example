# Copy this file to .env and fill in your own values:
#     copy .env_example .env        (Windows)
#     cp .env_example .env          (macOS / Linux)
# .env is listed in .gitignore, so your keys are never committed.

# ---------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------
# Qdrant Cloud cluster URL (Cloud console -> your cluster -> Endpoint), with port 6333
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
# Qdrant Cloud API key (Cloud console -> your cluster -> API Keys).
# Leave empty to use a local Docker Qdrant at http://127.0.0.1:6333 instead:
#     docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant:v1.20.0
QDRANT_API_KEY=

# ---------------------------------------------------------------
# Embeddings: Gemini Embedding 2 through the Euron gateway
# ---------------------------------------------------------------
# Euron API key. Leave empty to use 1,000 synthetic 3072-dim vectors instead.
# If data/docs.npy, data/queries.npy and data/texts.json exist, the notebook loads them
# and makes no API calls, but this key must still be non-empty to choose the Gemini path.
EURI_API_KEY=
# Gateway address (OpenAI-style /embeddings endpoint)
EURI_BASE_URL=https://api.euron.one/api/v1/euri
# Embedding model; it returns 3072-dimensional vectors
EMBED_MODEL=gemini-embedding-2

# ---------------------------------------------------------------
# Source data (optional)
# ---------------------------------------------------------------
# Where the SENTINEL document-chunk files are. Only needed when data/ is missing
# and the 1,000 chunks have to be embedded again.
CHUNKS_GLOB=C:\path\to\sentinel_data\tables\document_chunks\*\*.csv.gz
